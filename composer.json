{
    "name": "baykit/bayserver",
    "description": "One of the fastest web server",
    "version": "3.0.0",
    "require": {
      "ext-pcntl": "*",
      "baykit/croute": "*"
    },
    "autoload": {
        "psr-4": {
            "baykit\\bayserver\\": "packages/bayserver-core/baykit/bayserver",
            "baykit\\bayserver\\docker\\ajp\\": "packages/bayserver-docker-ajp/baykit/bayserver/docker/ajp",
            "baykit\\bayserver\\docker\\cgi\\": "packages/bayserver-docker-cgi/baykit/bayserver/docker/cgi",
            "baykit\\bayserver\\docker\\fcgi\\": "packages/bayserver-docker-fcgi/baykit/bayserver/docker/fcgi",
            "baykit\\bayserver\\docker\\http\\": "packages/bayserver-docker-http/baykit/bayserver/docker/http",
            "baykit\\bayserver\\docker\\h3\\": "packages/bayserver-docker-http3/baykit/bayserver/docker/h3",
            "baykit\\bayserver\\docker\\wordpress\\": "packages/bayserver-docker-wordpress/baykit/bayserver/docker/wordpress",
            "baykit\\bayserver\\docker\\phpverse\\": "packages/bayserver-docker-phpverse/baykit/bayserver/docker/phpverse",
            "phpverse\\": "packages/phpverse/src"
        }
    },
    "bin": ["packages/bayserver/bin/bayserver_php"]
}

